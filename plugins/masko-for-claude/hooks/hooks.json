{
  "description": "Forward high-signal Claude Cowork lifecycle hooks to Masko Desktop.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/masko-hook.sh"],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
